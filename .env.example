# ==========================================
# Portal Console Environment Configuration
# ==========================================

# Panel Giriş Bilgileri (Arayüz Şifresi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Gateway API Kimlik Bilgileri (Arayüzden de girilebilir)
CLICKSEND_USERNAME=your_username
CLICKSEND_API_KEY=your_api_key

# Opsiyonel Varsayılan Ayarlar
DEFAULT_DOMAIN=siteniz.com
DEFAULT_SENDER_ID=

# Kalıcı Veri Dizini (Docker/Dokploy içinde: /app/data)
DATA_DIR=/app/data
