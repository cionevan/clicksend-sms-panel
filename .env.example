# ==========================================
# ClickSend SMS & Dokploy Environment Config
# ==========================================

# ClickSend API Kimlik Bilgileri
# Dashboard üzerinden alabilirsiniz: https://dashboard.clicksend.com
# (Account Settings -> Subaccounts / API Credentials)
CLICKSEND_USERNAME=your_clicksend_username
CLICKSEND_API_KEY=your_clicksend_api_key

# Opsiyonel Varsayılan Ayarlar
DEFAULT_DOMAIN=siteniz.com
DEFAULT_SENDER_ID=

# Kalıcı Veri Dizini (Docker/Dokploy içinde varsayılan: /app/data)
DATA_DIR=/app/data
